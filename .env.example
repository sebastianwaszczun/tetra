# Plik .env jest opcjonalny: bez niego obowiązują wartości domyślne z docker-compose.yml.
# Żeby coś zmienić: skopiuj do .env (Windows: copy .env.example .env) i edytuj.
POSTGRES_USER=fake
POSTGRES_PASSWORD=fake
POSTGRES_DB=fakecollector
POSTGRES_PORT=5432

NEO4J_USER=neo4j
NEO4J_PASSWORD=fakecollector
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

JUPYTER_PORT=8888
JUPYTER_TOKEN=fake

# CPU (domyślnie). Dla GPU użyj docker-compose.gpu.yml.
TORCH_INDEX=https://download.pytorch.org/whl/cpu

API_PORT=8000
# front (GUI): http://localhost:8080
WEB_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- pierwszy start (usługi init i seed) ---
# modele obrazu pobierane do wolumenu models (raz)
IMAGE_MODELS=siglip2,clip,buffalo_l,yunet_sface,magface,facetorch
# 1 = pobierz od razu modele tekstu i audio (Hugging Face), 0 = przy pierwszej analizie
PRELOAD_MODELS=1
# foldery z materiałami wczytywane automatycznie, gdy baza jest pusta (rozdzielone spacją)
SEED_DIRS=data/BACKUP data/DANE
# 1 = transkrypcja filmów przy wczytywaniu, 0 = szybciej (odcisk głosu i dźwięku liczy się nadal)
SEED_ASR=1

# Skaner Biblioteki Reklam Meta (usługa scheduler i /adlib/* w API).
# Token użytkownika z Graph API Explorer (aplikacja z dostępem do Ad Library API,
# kroki na facebook.com/ads/library/api). Długoterminowy (ok. 60 dni): Access Token Debugger → „Extend Access Token”.
META_ACCESS_TOKEN=
# na_zywo albo odtwarzanie (zapisane odpowiedzi z data/adlib/nagrania, bez tokenu i sieci)
ADLIB_TRYB=na_zywo

# --- serwer (docker-compose.prod.yml) ---
# DOMAIN=fake.tetracore.pl
